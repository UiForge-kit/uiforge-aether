# Copiez ce fichier vers .env.local puis renseignez ce dont vous avez besoin.
# Sans aucune variable, l'application tourne sur son provider de démonstration.
# Les réponses sont simulées, le streaming est réel.

# Provider actif : mock | anthropic | openai
# Si la valeur est absente, la présence d'une clé suffit à l'activer.
AI_PROVIDER=mock

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# URL publique du déploiement (canonical, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true pour laisser les moteurs de recherche indexer le site. Fermé par défaut.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Requêtes autorisées par IP sur POST /api/chat, par fenêtre (défaut : 20).
API_RATE_LIMIT_MAX=20

# Durée de la fenêtre du rate limit, en secondes (défaut : 60).
API_RATE_LIMIT_WINDOW_SECONDS=60

# Page d'achat de l'offre Pro, liée depuis les modules verrouillés.
# Sans valeur, la carte « Disponible en Pro » s'affiche sans lien.
NEXT_PUBLIC_UPGRADE_URL=
